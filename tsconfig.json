{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "es2025",
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true,
        "types": [
            "@txikijs/types"
        ],
        "paths": {
            "bf": [
                "./images/alpine/overlay/etc/tjs/scripts/bf/index.ts"
            ]
        },
        // image overlays are merged in the image, so an image's scripts can import modules from its base image's
        "rootDirs": [
            "./images/alpine/overlay/etc/tjs/scripts",
            "./images/debian/overlay/etc/tjs/scripts"
        ]
    }
}